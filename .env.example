# Copy to .env and fill in from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_client_id
SPOTIPY_CLIENT_SECRET=your_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: free key from https://getsongbpm.com/api (requires a backlink to getsongbpm.com)
GETSONGBPM_API_KEY=
